# FalkorDB Cloud connection. Use a deployed, non-loopback endpoint.
FALKORDB_HOST=your-instance-host
FALKORDB_PORT=52327
FALKORDB_USERNAME=falkordb
FALKORDB_PASSWORD=replace-with-your-database-password
FALKORDB_GRAPH=techcompass
# Set true when TLS is enabled for your FalkorDB instance.
FALKORDB_TLS=true

# Groq model access (server-side only).
GROQ_API_KEY=replace-with-your-groq-api-key
# Optional; defaults are set by the application.
# GROQ_MODEL=openai/gpt-oss-20b

# Browser origins permitted to call the API.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional comma-separated public HTTPS RSS/Atom feeds (maximum 20).
# Article/feed URLs are fetched only when a user triggers ingestion.
# TECHCOMPASS_RSS_FEEDS=https://example.org/feed.xml,https://example.net/rss.xml
# Optional custom research queries. By default the top project npm dependencies
# (ranked by number of components using them) are queried, up to five terms.
# TECHCOMPASS_RESEARCH_TERMS=langchain,openai,retrieval augmented generation
# Optional comma-separated npm-package=owner/repository release targets (max 20).
# TECHCOMPASS_GITHUB_RELEASE_REPOS=langchain=langchain-ai/langchainjs,openai=openai/openai-node
# Optional public GitHub API token to raise unauthenticated rate limits.
# GITHUB_TOKEN=github_pat_...
# Optional NVD API key; without one, sync checks only five package keywords
# to stay within NVD's anonymous rate limit.
# NVD_API_KEY=replace-with-your-nvd-api-key
