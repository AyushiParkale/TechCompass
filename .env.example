# FalkorDB Cloud connection. Use a deployed, non-loopback endpoint.
FALKORDB_HOST=your-instance-host
FALKORDB_PORT=52327
FALKORDB_USERNAME=falkordb
FALKORDB_PASSWORD=replace-with-your-database-password
FALKORDB_GRAPH=techcompass
# Set true when TLS is enabled for your FalkorDB instance.
FALKORDB_TLS=true

# Gemini model access (server-side only).
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_API_KEY_2=optional-key-from-a-separate-google-project
# The default is Gemini 3.8 Flash. Override only with a model available to your API key.
# GEMINI_MODEL=gemini-3.8-flash
# Tavily web search for graph-context-driven research (server-side only).
TAVILY_API_KEY=replace-with-your-tavily-api-key
# Optional; defaults are set by the application.

# Browser origins permitted to call the API.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional public GitHub API token to raise unauthenticated rate limits.
# GITHUB_TOKEN=github_pat_...
# Optional NVD API key for explicit CVE searches.
# NVD_API_KEY=replace-with-your-nvd-api-key
