# FalkorDB Cloud connection. Use a deployed, non-loopback endpoint.
FALKORDB_HOST=your-instance-host
FALKORDB_PORT=52327
FALKORDB_USERNAME=falkordb
FALKORDB_PASSWORD=replace-with-your-database-password
FALKORDB_GRAPH=techcompass
# Set true when TLS is enabled for your FalkorDB instance.
FALKORDB_TLS=true

# Groq model access (server-side only).
GROQ_API_KEY=replace-with-your-groq-api-key
# Optional; defaults are set by the application.
# GROQ_MODEL=openai/gpt-oss-20b

# Private shared-password chat authentication.
TECHCOMPASS_ACCESS_PASSWORD=replace-with-a-strong-private-password
TECHCOMPASS_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# Browser origins permitted to call the API.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
