openapi: 3.1.0
info:
  title: TechCompass Project Update API
  version: 0.1.0
  description: Fixed update report backed by the AnythingLLM project graph and live external search.
servers:
  - url: http://localhost:8000
    description: Local development backend
paths:
  /health/live:
    get:
      operationId: livenessCheck
      responses:
        '200':
          description: Backend process is running
  /health/ready:
    get:
      operationId: readinessCheck
      responses:
        '200':
          description: FalkorDB graph is reachable
  /api/updates/run:
    post:
      operationId: runAnythingLLMUpdateReport
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [days]
              properties:
                days:
                  type: integer
                  minimum: 1
                  maximum: 90
                  default: 30
      responses:
        '200':
          description: Server-sent progress events followed by the report and search audit
          content:
            text/event-stream:
              schema:
                type: string
                description: >-
                  Events are JSON data frames with type progress, report, or error.
