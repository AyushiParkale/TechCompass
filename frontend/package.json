{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "scripts": {
    "build": "node build.mjs"
  },
  "app": {
    "name": "TechCompass",
    "description": "Graph-backed AnythingLLM technology update reports",
    "projectName": "AnythingLLM",
    "repositoryUrl": "https://github.com/Mintplex-Labs/anything-llm",
    "defaultBranch": "master"
  },
  "frontend": {
    "apiBaseUrl": "http://localhost:8000",
    "credentials": "omit",
    "requestTimeoutMs": null,
    "demoMode": true,
    "markDemoRecords": true
  },
  "integration": {
    "backendFramework": "FastAPI",
    "health": {
      "method": "GET",
      "path": "/health/ready"
    },
    "updateReport": {
      "run": "/api/updates/run",
      "progressProtocol": "server-sent events",
      "maximumLookbackDays": 90
    }
  },
  "integrationNotes": [
    "The frontend runs one fixed project update job and renders streamed progress followed by a report.",
    "Never put Gemini keys, FalkorDB credentials, or other secrets in browser code.",
    "Keep demo fixtures labelled until data comes from a verified backend response.",
    "Use JSON responses and consistent error objects; enable CORS only for the frontend origin."
  ],
  "signalRecordExample": {
    "id": "sig-101",
    "title": "Example signal title",
    "publisher": "Publisher name",
    "sourceType": "Research",
    "date": "2026-10-15",
    "discoveredAt": "2026-10-15T10:00:00Z",
    "score": 75,
    "impact": 2,
    "tags": [
      "RAG",
      "Evaluation"
    ],
    "component": "Retrieval pipeline",
    "status": "new",
    "summary": "Short summary",
    "longSummary": "Full analysis",
    "relevance": "Why it may matter",
    "reason": "Evidence for classification",
    "sourceUrl": "https://example.org/source",
    "evidence": [
      {
        "title": "Evidence item",
        "detail": "Source-backed evidence",
        "sourceRef": "optional-source-id"
      }
    ],
    "opportunity": {
      "title": "Potential opportunity",
      "description": "Potential improvement"
    },
    "planSteps": [
      "Verify source",
      "Map components",
      "Test proposal"
    ],
    "isDemo": true
  },
  "planRecordExample": {
    "id": "plan-201",
    "title": "Example implementation plan",
    "priority": "High",
    "areas": "Retrieval pipeline, evaluation",
    "status": "Proposed",
    "progress": 0,
    "updatedAt": "2026-10-15T10:00:00Z",
    "tasks": [
      "Verify source evidence",
      "Inspect related components"
    ],
    "sourceSignalIds": [
      "sig-101"
    ]
  },
  "graphNodeExample": {
    "id": "retrieval",
    "label": "Retrieval",
    "type": "component",
    "description": "Repository-backed component description",
    "sourceRef": "path-or-document-reference",
    "isDemo": false
  },
  "allowedValues": {
    "signalStatus": [
      "new",
      "reviewed",
      "dismissed"
    ],
    "planStatus": [
      "Proposed",
      "Under Review",
      "Approved",
      "In Progress",
      "Completed"
    ],
    "sourceType": [
      "Official release",
      "Engineering blog",
      "Research",
      "Security advisory"
    ],
    "graphNodeType": [
      "component",
      "package",
      "document",
      "concept"
    ]
  }
}
